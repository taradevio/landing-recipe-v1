---
import BaseLayout from '../layouts/BaseLayout.astro';
import Demo from '../components/Demo.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HouseholdFeature from '../components/HouseholdFeature.astro';
import PersonalJourney from '../components/PersonalJourney.astro';
import RecipeMethods from '../components/RecipeMethods.astro';
import ScatteredRecipes from '../components/ScatteredRecipes.astro';
import { siteContent } from '../content/siteContent';
---

<BaseLayout
  title={`${siteContent.product.name} — ${siteContent.product.tagline}`}
  description={siteContent.product.description}
>
  <Header navigation={siteContent.navigation} cta={siteContent.primaryCta} />
  <main id="main-content">
    <Hero tagline={siteContent.product.tagline} description={siteContent.product.description} cta={siteContent.primaryCta} />
    <ScatteredRecipes />
    <PersonalJourney />
    <Demo demo={siteContent.demo} />
    <RecipeMethods sources={siteContent.recipeSources} />
    <HouseholdFeature />
    <Faq items={siteContent.faq} />
    <FinalCta cta={siteContent.primaryCta} />
  </main>
  <Footer links={siteContent.links} />

  <script>
    const revealItems = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion && 'IntersectionObserver' in window) {
      revealItems.forEach((item) => item.classList.add('is-ready'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
