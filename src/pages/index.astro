---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingScene from '../components/ClosingScene.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HouseholdSpotlight from '../components/HouseholdSpotlight.astro';
import ProblemBridge from '../components/ProblemBridge.astro';
import ProductBridge from '../components/ProductBridge.astro';
import ProductProof from '../components/ProductProof.astro';
import Reliability from '../components/Reliability.astro';
import StoryFeatures from '../components/StoryFeatures.astro';
import SupportingFeatures from '../components/SupportingFeatures.astro';
import { siteContent } from '../content/siteContent';
---

<BaseLayout
  title={siteContent.metadata.title}
  description={siteContent.metadata.description}
  socialImage={siteContent.metadata.socialImage}
>
  <Header navigation={siteContent.navigation} availability={siteContent.availability} />
  <main id="main-content">
    <Hero brand={siteContent.brand} hero={siteContent.hero} availability={siteContent.availability} />
    <ProblemBridge problem={siteContent.problem} />
    <ProductBridge title={siteContent.productBridge.title} />
    <ProductProof proof={siteContent.productProof} />
    <StoryFeatures stories={siteContent.stories} />
    <HouseholdSpotlight household={siteContent.household} />
    <SupportingFeatures features={siteContent.supportingFeatures} />
    <Reliability reliability={siteContent.reliability} />
    <ClosingScene scene={siteContent.closingScene} availability={siteContent.availability} />
  </main>
  <Footer footer={siteContent.footer} />

  <script>
    const revealItems = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion && 'IntersectionObserver' in window) {
      revealItems.forEach((item) => item.classList.add('is-ready'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
