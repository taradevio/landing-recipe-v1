---
import type { SiteContent } from '../content/siteContent';
import Wordmark from './Wordmark.astro';

interface Props {
  footer: SiteContent['footer'];
}

const { footer } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-wordmark" aria-hidden="true"><Wordmark large /></div>
  <div class="shell footer-inner">
    <p>{footer.signature}</p>
    <nav aria-label="Footer navigation">
      {footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
  <div class="shell footer-bottom">
    <p>© {year} Noomori</p>
    <p>Android app coming soon</p>
  </div>
</footer>
