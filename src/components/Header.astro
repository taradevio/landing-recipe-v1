---
import BrandMark from './BrandMark.astro';
import StoreCta from './StoreCta.astro';
import type { CtaLink } from '../content/siteContent';

interface Props {
  navigation: Array<{ label: string; href: string }>;
  cta: CtaLink;
}

const { navigation, cta } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-link" href="#top" aria-label="Recipe App home">
      <BrandMark compact />
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-cta">
      <StoreCta cta={cta} compact />
    </div>
    <a class="mobile-demo-link" href="#how-it-works">See demo</a>
  </div>
</header>
