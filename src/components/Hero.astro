---
import { ArrowDownRight } from '@lucide/astro';
import type { SiteContent } from '../content/siteContent';
import Availability from './Availability.astro';
import ProductMedia from './ProductMedia.astro';

interface Props {
  brand: SiteContent['brand'];
  hero: SiteContent['hero'];
  availability: SiteContent['availability'];
}

const { brand, hero, availability } = Astro.props;
---

<section class="hero" id="top" data-header-sentinel>
  <div class="hero-light" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow">{brand.eyebrow}</span>
      <h1>{hero.headline}</h1>
      <p>{hero.description}</p>
      <div class="hero-actions">
        <a class="primary-action" href={hero.secondaryAction.href}>
          <span>{hero.secondaryAction.label}</span>
          <span class="action-icon"><ArrowDownRight aria-hidden="true" size={18} stroke-width={1.8} /></span>
        </a>
        <Availability action={availability} />
      </div>
    </div>
    <div class="hero-media" aria-label="Noomori product previews">
      {hero.media.map((media, index) => (
        <ProductMedia
          media={media}
          prominent={index === 1}
          class={`hero-media-card hero-media-card--${index + 1}`}
        />
      ))}
    </div>
  </div>
</section>
