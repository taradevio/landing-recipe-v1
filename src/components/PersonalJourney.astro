---
import { ArrowRight, Heart, UsersRound } from '@lucide/astro';
import PhoneMockup from './PhoneMockup.astro';
---

<section class="section journey" aria-labelledby="journey-heading">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Yours first. Ours when you choose.</span>
      <h2 id="journey-heading">Start with your favorites. <span>Build a household cookbook together.</span></h2>
    </div>
    <div class="journey-grid">
      <article class="journey-panel journey-panel--personal" data-reveal>
        <div class="journey-copy">
          <span class="meaning-badge meaning-badge--coral"><Heart aria-hidden="true" size={17} /> Personal</span>
          <h3>Your recipe collection</h3>
          <p>Keep the dishes you want to remember in a cookbook that feels like your own.</p>
        </div>
        <PhoneMockup variant="personal" label="Personal Recipe App cookbook with three saved recipes" />
      </article>
      <div class="journey-connector">
        <span><small>Invite people</small>Share the recipes everyone loves</span>
        <ArrowRight aria-hidden="true" size={28} />
      </div>
      <article class="journey-panel journey-panel--household" data-reveal>
        <div class="journey-copy">
          <span class="meaning-badge meaning-badge--seafoam"><UsersRound aria-hidden="true" size={17} /> Household</span>
          <h3>One shared kitchen</h3>
          <p>Give everyone the same trusted collection, ready when it is their turn to cook.</p>
        </div>
        <PhoneMockup variant="household" label="Shared household cookbook with members and recently added recipes" />
      </article>
    </div>
  </div>
</section>
