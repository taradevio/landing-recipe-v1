---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['brand-mark', { 'brand-mark--compact': compact }]}>
  <svg aria-hidden="true" viewBox="0 0 48 48" width="40" height="40">
    <rect width="48" height="48" rx="14" fill="var(--color-peach)" />
    <path d="M10 21h28c0 10-5.7 16-14 16S10 31 10 21Z" fill="var(--color-personal)" stroke="var(--color-ink)" stroke-width="2.5" />
    <path d="M24 21c-.5-5 2.8-8.8 8-10-.5 4.8-3.3 8-8 10Z" fill="var(--color-household)" stroke="var(--color-ink)" stroke-width="2" stroke-linejoin="round" />
  </svg>
  <span>Recipe App</span>
</span>
