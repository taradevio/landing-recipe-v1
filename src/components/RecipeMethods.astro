---
import { Info, Link2, PencilLine } from '@lucide/astro';
import type { RecipeSource } from '../content/siteContent';
import InstagramGlyph from './InstagramGlyph.astro';

interface Props {
  sources: RecipeSource[];
}

const { sources } = Astro.props;
const icons = { pencil: PencilLine, link: Link2, instagram: InstagramGlyph };
---

<section class="section methods" id="add-recipes" aria-labelledby="methods-heading">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">However you found it</span>
      <h2 id="methods-heading">Three easy ways to <span>bring a recipe home.</span></h2>
      <p>Start from scratch or use the written recipe information you already have.</p>
    </div>
    <div class="method-grid">
      {sources.map((source, index) => {
        const Icon = icons[source.icon];
        return (
          <article class:list={['method-card', 'card', `method-card--${source.accent}`]} data-reveal>
            <div class="method-topline">
              <span class:list={['method-icon', `method-icon--${source.icon}`]}><Icon aria-hidden="true" size={18} /></span>
              <span class="method-number">0{index + 1}</span>
            </div>
            <h3>{source.title}</h3>
            <p>{source.description}</p>
            {source.note && <p class="method-note"><Info aria-hidden="true" size={17} /><span>{source.note}</span></p>}
          </article>
        );
      })}
    </div>
  </div>
</section>
