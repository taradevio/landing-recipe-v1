---
import { ArrowLeft, Bookmark, ChevronRight, Clock3, House, Search, UsersRound } from '@lucide/astro';

interface Props {
  variant?: 'home' | 'personal' | 'household';
  label: string;
  class?: string;
}

const { variant = 'home', label, class: className } = Astro.props;
---

<figure class:list={['phone', `phone--${variant}`, className]} aria-label={label} role="img">
  <div class="phone-frame">
    <div class="phone-speaker" aria-hidden="true"></div>
    <div class="phone-screen">
      <div class="phone-status" aria-hidden="true"><span>9:41</span><span>•••</span></div>
      {variant === 'home' && (
        <>
          <div class="app-title-row">
            <div><span class="app-kicker">Good evening</span><strong>What are we cooking?</strong></div>
            <span class="avatar">M</span>
          </div>
          <div class="app-search"><Search aria-hidden="true" size={14} /><span>Search your recipes</span></div>
          <div class="featured-recipe">
            <div class="recipe-art recipe-art--pasta" aria-hidden="true"><span></span><span></span><span></span></div>
            <div><span class="mini-label">Tonight's idea</span><strong>Roasted tomato pasta</strong><small><Clock3 aria-hidden="true" size={11} /> 35 min</small></div>
          </div>
          <div class="phone-section-title"><strong>Your cookbooks</strong><span>See all</span></div>
          <div class="cookbook-row">
            <div class="mini-book mini-book--coral"><Bookmark aria-hidden="true" size={15} /><strong>Weeknight wins</strong><small>18 recipes</small></div>
            <div class="mini-book mini-book--seafoam"><UsersRound aria-hidden="true" size={15} /><strong>Our kitchen</strong><small>31 recipes</small></div>
          </div>
          <div class="app-bottom-nav" aria-hidden="true"><span class="active"><House size={15} />Home</span><span><Search size={15} />Search</span><span><Bookmark size={15} />Saved</span></div>
        </>
      )}
      {variant === 'personal' && (
        <>
          <div class="app-toolbar"><ArrowLeft aria-hidden="true" size={16} /><strong>My cookbook</strong><span>•••</span></div>
          <div class="collection-heading collection-heading--coral">
            <span class="app-kicker">PERSONAL</span>
            <strong>Recipes I love</strong>
            <small>14 recipes · just for you</small>
          </div>
          <div class="recipe-list">
            <div class="recipe-list-item"><span class="food-thumb food-thumb--soup"></span><div><strong>Ginger chicken soup</strong><small>From my notebook</small></div><ChevronRight size={14} /></div>
            <div class="recipe-list-item"><span class="food-thumb food-thumb--toast"></span><div><strong>Sunday french toast</strong><small>Saved from a website</small></div><ChevronRight size={14} /></div>
            <div class="recipe-list-item"><span class="food-thumb food-thumb--salad"></span><div><strong>Crispy herb salad</strong><small>Created by me</small></div><ChevronRight size={14} /></div>
          </div>
        </>
      )}
      {variant === 'household' && (
        <>
          <div class="app-toolbar"><ArrowLeft aria-hidden="true" size={16} /><strong>Our kitchen</strong><span>•••</span></div>
          <div class="collection-heading collection-heading--seafoam">
            <span class="app-kicker">HOUSEHOLD</span>
            <strong>The family cookbook</strong>
            <small><UsersRound aria-hidden="true" size={12} /> You, Alex & Sam</small>
          </div>
          <div class="shared-note"><span class="avatar avatar--small">A</span><p><strong>Alex added</strong> Lemon tray bake</p></div>
          <div class="recipe-list">
            <div class="recipe-list-item"><span class="food-thumb food-thumb--lemon"></span><div><strong>Lemon tray bake</strong><small>Added today</small></div><ChevronRight size={14} /></div>
            <div class="recipe-list-item"><span class="food-thumb food-thumb--curry"></span><div><strong>Weeknight curry</strong><small>Sam's favorite</small></div><ChevronRight size={14} /></div>
          </div>
        </>
      )}
    </div>
  </div>
</figure>
