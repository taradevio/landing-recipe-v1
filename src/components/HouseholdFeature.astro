---
import { Check, CookingPot, Heart, UserPlus, UsersRound } from '@lucide/astro';
---

<section class="section household-feature" id="household" aria-labelledby="household-heading">
  <div class="shell household-shell">
    <div class="household-copy" data-reveal>
      <span class="eyebrow eyebrow--teal">A cookbook for the people around your table</span>
      <h2 id="household-heading">Everyone knows what’s for dinner.</h2>
      <p>Gather the recipes your household relies on, so the right version is easy to find—whoever happens to be cooking.</p>
      <ul class="feature-list">
        <li><span><Check aria-hidden="true" size={17} /></span><div><strong>A collection you build together</strong><small>Keep shared favorites in one household cookbook.</small></div></li>
        <li><span><Check aria-hidden="true" size={17} /></span><div><strong>Clear ownership cues</strong><small>Personal and household labels use words and icons, not color alone.</small></div></li>
        <li><span><Check aria-hidden="true" size={17} /></span><div><strong>Less recipe detective work</strong><small>Stop searching old messages for the same link again.</small></div></li>
      </ul>
    </div>
    <div class="household-scene" data-reveal aria-label="Household cookbook interface preview">
      <div class="household-ring household-ring--one" aria-hidden="true"></div>
      <div class="household-ring household-ring--two" aria-hidden="true"></div>
      <div class="shared-board card">
        <div class="shared-board-header">
          <div><span class="board-icon"><CookingPot aria-hidden="true" size={22} /></span><div><small>HOUSEHOLD COOKBOOK</small><strong>Our kitchen</strong></div></div>
          <span class="member-count"><UsersRound aria-hidden="true" size={15} /> 3</span>
        </div>
        <div class="member-row">
          <span class="member member--one">M</span><span class="member member--two">A</span><span class="member member--three">S</span>
          <span class="member-label">You, Alex & Sam</span>
          <span class="invite-icon"><UserPlus aria-hidden="true" size={17} /></span>
        </div>
        <div class="board-recipes">
          <article><span class="board-food board-food--pasta"></span><div><strong>Roasted tomato pasta</strong><small>Added by you</small></div><Heart aria-label="Household favorite" size={16} fill="currentColor" /></article>
          <article><span class="board-food board-food--bake"></span><div><strong>Lemon tray bake</strong><small>Added by Alex</small></div><Heart aria-label="Household favorite" size={16} fill="currentColor" /></article>
          <article><span class="board-food board-food--curry"></span><div><strong>Weeknight curry</strong><small>Added by Sam</small></div><Heart aria-label="Household favorite" size={16} fill="currentColor" /></article>
        </div>
      </div>
      <div class="scene-note scene-note--left"><span class="member member--two">A</span><span><strong>Alex added a recipe</strong><small>Lemon tray bake</small></span></div>
      <div class="scene-note scene-note--right"><Heart aria-hidden="true" size={18} fill="currentColor" /><span><strong>Family favorite</strong><small>Saved by everyone</small></span></div>
    </div>
  </div>
</section>
