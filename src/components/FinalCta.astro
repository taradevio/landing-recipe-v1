---
import { Heart, Sparkles } from '@lucide/astro';
import type { CtaLink } from '../content/siteContent';
import StoreCta from './StoreCta.astro';

interface Props {
  cta: CtaLink;
}

const { cta } = Astro.props;
---

<section class="final-cta section" aria-labelledby="final-heading">
  <div class="shell">
    <div class="final-panel" data-reveal>
      <div class="final-spark final-spark--one" aria-hidden="true"><Sparkles size={26} /></div>
      <div class="final-spark final-spark--two" aria-hidden="true"><Heart size={24} fill="currentColor" /></div>
      <div class="final-copy">
        <span class="eyebrow eyebrow--dark">Your next family favorite is worth keeping</span>
        <h2 id="final-heading">Bring every recipe home.</h2>
        <p>Save what you love today, then share the dishes that deserve a place at everyone’s table.</p>
        <StoreCta cta={cta} tone="cream" />
      </div>
      <div class="final-bowl" aria-hidden="true">
        <span class="leaf leaf--one"></span><span class="leaf leaf--two"></span><span class="leaf leaf--three"></span>
        <div class="bowl-rim"></div><div class="bowl-body"></div>
      </div>
    </div>
  </div>
</section>
