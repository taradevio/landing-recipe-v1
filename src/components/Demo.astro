---
import { BookmarkPlus, Check, Clapperboard, Share2 } from '@lucide/astro';
import type { SiteContent } from '../content/siteContent';

interface Props {
  demo: SiteContent['demo'];
}

const { demo } = Astro.props;
const icons = [BookmarkPlus, Check, Share2];
---

<section class="section demo" id="how-it-works" aria-labelledby="demo-heading">
  <div class="shell">
    <div class="section-heading section-heading--center" data-reveal>
      <span class="eyebrow">A simple path from found to family favorite</span>
      <h2 id="demo-heading">{demo.title}</h2>
      <p>Here is the experience we are building, shown without pretending unfinished media is ready.</p>
    </div>
    {demo.src ? (
      <video class="demo-video" controls poster={demo.poster?.src} preload="metadata">
        <source src={demo.src} />
        {demo.captionTrack && <track kind="captions" src={demo.captionTrack} srclang="en" label="English" default />}
        Your browser does not support the demo video.
      </video>
    ) : (
      <div class="demo-poster card" data-reveal aria-label="Recipe App demo storyboard">
        <div class="demo-notice"><Clapperboard aria-hidden="true" size={19} /><span>Demo video coming soon</span></div>
        <div class="storyboard">
          {demo.steps.map((step, index) => {
            const Icon = icons[index];
            return (
              <article class="story-step">
                <span class="story-number">0{index + 1}</span>
                <span class="story-icon"><Icon aria-hidden="true" size={22} /></span>
                <span class="story-eyebrow">{step.eyebrow}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            );
          })}
        </div>
        <div class="demo-progress" aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
    )}
  </div>
</section>
